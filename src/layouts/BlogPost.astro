---
import SEO    from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  slug: string;
  image: string;
  datePublished: string;
  dateModified: string;
  author?: string;
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  slug,
  image,
  datePublished,
  dateModified,
  author = 'Badreddine Br',
  faqs = [],
} = Astro.props;

const suffix = ' | Outdoor & Coastal Home Decor';
const pageTitle = (title.length + suffix.length) <= 60 ? `${title}${suffix}` : title;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <SEO
      title={pageTitle}
      description={description}
      slug={slug}
      image={image}
      datePublished={datePublished}
      dateModified={dateModified}
      authorName={author}
      type="article"
      faqs={faqs}
    />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
