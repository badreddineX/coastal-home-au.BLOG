---
interface Props {
  title: string;
  description: string;
  slug?: string;
  path?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  slug = '',
  path = '',
  image = '/images/unsplash-1600566753086-00f18fb6b3ea.jpg',
  datePublished = new Date().toISOString(),
  dateModified = new Date().toISOString(),
  authorName = 'Badreddine Br',
  type = 'website',
} = Astro.props;

const siteUrl = 'https://outdoorcoastalhome.com';
const fullUrl  = slug ? `${siteUrl}/blog/${slug}` : path ? `${siteUrl}${path}` : siteUrl;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const siteName = 'Outdoor & Coastal Home Decor';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: fullImage,
  datePublished,
  dateModified,
  author: {
    '@type': 'Person',
    name: authorName,
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
};
---

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Primary -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="author" content={authorName} />
<link rel="canonical" href={fullUrl} />
<link rel="alternate" type="application/rss+xml" title="Outdoor & Coastal Home Decor" href="/rss.xml" />
<meta name="google-site-verification" content="lOfz9zbPlTEx3HUAUZ81yM1h--j7hzy2pByICeAqYhU" />

<!-- Open Graph -->
<meta property="og:type"        content={type} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:url"         content={fullUrl} />
<meta property="og:image"       content={fullImage} />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale"      content="en_AU" />
<meta property="og:site_name"   content={siteName} />

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={fullImage} />

<!-- Article meta -->
{type === 'article' && (
  <>
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time"  content={dateModified} />
    <meta property="article:author"         content={authorName} />
  </>
)}

<!-- JSON-LD -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

<!-- Fallback for broken images -->
<script is:inline>
window.addEventListener('error', function (e) {
  var t = e.target;
  if (t && t.tagName === 'IMG' && !t.dataset.fellBack) {
    t.dataset.fellBack = '1';
    t.removeAttribute('srcset');
    t.src = '/images/placeholder.svg';
  }
}, true);
</script>

<!-- Google Analytics (gtag.js) -- injected via JS on the `load` event, not
     `defer`. `defer` only delays *execution*, not the network fetch -- the
     browser starts downloading deferred <script src> tags immediately during
     parsing, so on a throttled connection they'd compete with the hero image
     and fonts for bandwidth and hurt LCP/FCP (same fix already applied on
     Canada/UK). Injecting on `load` keeps it out of the network queue
     entirely until everything above-the-fold has already finished loading. -->
<script is:inline>(function(w,d,s,l,gaId){
  function start(){
    w[l]=w[l]||[];
    var g=d.createElement(s);
    g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id='+gaId;
    d.getElementsByTagName(s)[0].parentNode.insertBefore(g,d.getElementsByTagName(s)[0]);
    function gtag(){w[l].push(arguments);}
    w.gtag=gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }
  if (d.readyState === 'complete') start();
  else w.addEventListener('load', start);
})(window,document,'script','dataLayer','G-J4G9ZWD2V2');</script>
<!-- End Google Analytics -->
