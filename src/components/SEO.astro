---
interface Props {
  title: string;
  description: string;
  slug?: string;
  path?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  type?: 'website' | 'article';
  faqs?: { q: string; a: string }[];
}

const {
  title,
  description,
  slug = '',
  path = '',
  image = '/images/unsplash-1600566753086-00f18fb6b3ea.jpg',
  datePublished = new Date().toISOString(),
  dateModified = new Date().toISOString(),
  authorName = 'Badreddine Br',
  type = 'website',
  faqs = [],
} = Astro.props;

const siteUrl = 'https://outdoorcoastalhome.com';
const fullUrl  = slug ? `${siteUrl}/blog/${slug}` : path ? `${siteUrl}${path}` : siteUrl;
const fullImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const siteName = 'Outdoor & Coastal Home Decor';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: fullImage,
  datePublished,
  dateModified,
  author: {
    '@type': 'Person',
    name: authorName,
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': fullUrl },
};

// Breadcrumb + FAQ schema render inside <head> here (not as standalone
// top-level <script> tags in the page body) -- those used to sit before
// <html> even opened, pushing everything after them (including the
// charset meta tag) past the ~1024-byte window browsers scan for an
// encoding hint, which was the actual cause of intermittent mojibake.
const breadcrumbSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: fullUrl },
  ],
} : null;

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

// WebSite + Organization schema for non-article pages (homepage, /about,
// /blog index, legal pages) -- these previously shipped zero structured
// data since articleSchema only renders when type === 'article'.
const websiteSchema = type === 'website' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl,
  description,
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
  },
} : null;

const webPageSchema = type === 'website' ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: fullUrl,
  isPartOf: { '@type': 'WebSite', name: siteName, url: siteUrl },
} : null;
---

<!-- Charset must be the very first thing in <head> -- browsers only scan the
     first ~1024 bytes for a charset meta tag before falling back to a
     locale-based guess, which was rendering UTF-8 em-dashes as mojibake
     (e.g. "Australian homes â€" layouts") on some loads because this tag
     used to sit after the font/favicon links, past that window. -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Preload the two font files that actually carry visible text (Inter 400
     for body copy, Playfair Display italic 600 for H2/H3/TL;DR marker --
     matches the weight .post-content h2 requests). global.css inlines
     @font-face rules with font-display:swap but nothing was preloading the
     files themselves -- the browser only discovered it needed them during
     layout, so the swap from fallback (Georgia/sans-serif) to the real font
     happened well after first paint. PageSpeed traced the page's largest
     layout shift (CLS 0.123 of 0.133 total, https://pagespeed.web.dev on
     small-courtyard-garden-ideas-australia, 2026-08-13) to <article
     class="post-main"> -- every heading and paragraph in the article
     reflowing at once when the real fonts finally swapped in is a better
     fit for that evidence than the H2/H3 client-side numbering script this
     session first (incorrectly) suspected and fixed anyway. -->
<link rel="preload" as="font" type="font/woff2" crossorigin
  href="https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin
  href="https://fonts.gstatic.com/s/playfairdisplay/v40/nuFkD-vYSZviVYUb_rj3ij__anPXDTnogkk7.woff2" />
<!-- Loaded non-render-blocking: a synchronous <link rel="stylesheet"> here was
     flagged by PageSpeed as costing ~750ms on the critical path for a
     script/display font that's only used for a handful of italic headings,
     not body text. media="print" tricks the browser into fetching it without
     blocking render, then the onload swap applies it once ready. -->
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
<noscript><link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet" /></noscript>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Primary -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta name="author" content={authorName} />
<link rel="canonical" href={fullUrl} />
<link rel="alternate" type="application/rss+xml" title="Outdoor & Coastal Home Decor" href="/rss.xml" />
<meta name="google-site-verification" content="lOfz9zbPlTEx3HUAUZ81yM1h--j7hzy2pByICeAqYhU" />

<!-- Open Graph -->
<meta property="og:type"        content={type} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:url"         content={fullUrl} />
<meta property="og:image"       content={fullImage} />
<meta property="og:image:width"  content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale"      content="en_AU" />
<meta property="og:site_name"   content={siteName} />

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={fullImage} />

<!-- Article meta -->
{type === 'article' && (
  <>
    <meta property="article:published_time" content={datePublished} />
    <meta property="article:modified_time"  content={dateModified} />
    <meta property="article:author"         content={authorName} />
  </>
)}

<!-- JSON-LD -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
{websiteSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}
{webPageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
)}

<!-- Fallback for broken images -->
<script is:inline>
window.addEventListener('error', function (e) {
  var t = e.target;
  if (t && t.tagName === 'IMG' && !t.dataset.fellBack) {
    t.dataset.fellBack = '1';
    t.removeAttribute('srcset');
    t.src = '/images/placeholder.svg';
  }
}, true);
</script>

<!-- Google Tag Manager + gtag.js -- injected via JS on the `load` event, not
     `defer`. `defer` only delays *execution*, not the network fetch -- the
     browser starts downloading deferred <script src> tags immediately during
     parsing, so on a throttled connection they'd compete with the hero image
     and fonts for bandwidth and hurt LCP/FCP (same fix already applied on
     Canada/UK). Injecting on `load` keeps it out of the network queue
     entirely until everything above-the-fold has already finished loading. -->
<script is:inline>(function(w,d,s,l,gtmId,gaId){
  function start(){
    w[l]=w[l]||[];w[l].push({'gtm.start': new Date().getTime(),event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0];
    var j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+gtmId+dl;
    f.parentNode.insertBefore(j,f);

    var g=d.createElement(s);
    g.async=true;g.src='https://www.googletagmanager.com/gtag/js?id='+gaId;
    f.parentNode.insertBefore(g,f);
    function gtag(){w.dataLayer.push(arguments);}
    w.gtag=gtag;
    gtag('js', new Date());
    gtag('config', gaId);
  }
  if (d.readyState === 'complete') start();
  else w.addEventListener('load', start);
})(window,document,'script','dataLayer','GTM-MC5RJFSF','G-J4G9ZWD2V2');</script>
<!-- End Google Tag Manager + gtag.js -->

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MC5RJFSF"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
