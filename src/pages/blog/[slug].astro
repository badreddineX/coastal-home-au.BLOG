---
import { getCollection, render }  from 'astro:content';
import BlogPost            from '../../layouts/BlogPost.astro';
import TLDRBox             from '../../components/TLDRBox.astro';
import FAQ                 from '../../components/FAQ.astro';
import PostCard            from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  description,
  image,
  datePublished,
  dateModified,
  author = 'Badreddine Br',
  category,
  readTime,
  tldr = [],
  faqs = [],
  tags = [],
} = post.data;

// WebP sibling generated by scripts/generate-webp.mjs -- see PostCard.astro
// for why this is a <picture> fallback rather than astro:assets.
const imageWebp = image.replace(/\.(jpe?g|png)$/i, '.webp');

const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => {
    const aMatch = a.data.category === category ? 1 : 0;
    const bMatch = b.data.category === category ? 1 : 0;
    if (bMatch !== aMatch) return bMatch - aMatch;
    return new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime();
  })
  .slice(0, 3);

const formattedDate = new Date(datePublished).toLocaleDateString('en-AU', {
  day: 'numeric', month: 'long', year: 'numeric',
});

---

<BlogPost
  title={title}
  description={description}
  slug={post.id}
  image={image}
  datePublished={datePublished}
  dateModified={dateModified}
  author={author}
  faqs={faqs}
>
  <div class="reading-progress" id="reading-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-label="Reading progress"></div>

  <button id="back-to-top" class="back-to-top" aria-label="Back to top">
    <svg viewBox="0 0 16 16" fill="none" width="18" height="18" aria-hidden="true">
      <path d="M8 12V4M4 8l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="post-wrap">

    <!-- ── Post header (full width) ── -->
    <div class="post-header-wrap">
      <div class="post-header container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumb-sep" aria-hidden="true">›</span>
          <a href="/blog">Blog</a>
          <span class="breadcrumb-sep" aria-hidden="true">›</span>
          <span aria-current="page">{category}</span>
        </nav>

        <span class="pill post-cat">{category}</span>
        <h1 class="display post-title">{title}</h1>

        <div class="post-meta">
          <span class="post-meta-author">{author}</span>
          <span aria-hidden="true" class="post-meta-sep">·</span>
          <time datetime={datePublished}>{formattedDate}</time>
          <span aria-hidden="true" class="post-meta-sep">·</span>
          <span>{readTime}</span>
        </div>
      </div>
    </div>

    <!-- ── Featured image (full width, above the two-column layout) ──
         Kept as its own block outside .post-layout so mobile's TOC
         reordering (order:-1 on .post-sidebar, see below) can't drag the
         TOC above it -- otherwise the image gets pushed below the fold
         while the TOC sits glued to the title, which is the opposite of
         "TOC moves with the title" (Canada/UK keep the hero fully separate
         from the two-column grid for the same reason). -->
    <div class="hero-section">
      <div class="img-wrap post-hero-img">
        <picture>
          <source srcset={imageWebp} type="image/webp" />
          <img
            src={image}
            alt={title}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="container post-layout">

      <!-- Main content -->
      <article class="post-main">

        <!-- TL;DR -->
        {tldr.length > 0 && <TLDRBox points={tldr} />}

        <!-- Content -->
        <div class="post-content post-body">
          <Content />
        </div>

        <!-- FAQ -->
        {faqs.length > 0 && <FAQ questions={faqs} />}

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => (
              <a class="post-tag" href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>
            ))}
          </div>
        )}

        <!-- Author bio -->
        <div class="author-bio">
          <div class="author-bio-logo" aria-hidden="true">
            <span class="bio-logo-initial">B</span>
          </div>
          <div>
            <span class="author-bio-name">{author}</span>
            <p>
              Badreddine is a home decor enthusiast sharing coastal living and outdoor entertaining ideas for Australian homes — with the right seasons, the right retailers, and the right climate in mind.
            </p>
          </div>
        </div>

      </article>

      <!-- Sticky sidebar -->
      <aside class="post-sidebar">

        <!-- TOC Widget -->
        <div class="toc-widget" id="sidebar-toc">
          <div class="toc-widget__header" id="toc-header">
            <h2 class="toc-widget__header-title">Table of Contents</h2>
            <button type="button" class="toc-widget__toggle-button toc-widget__toggle-button--collapse" aria-label="Close table of contents">
              <svg viewBox="0 0 448 512"><path d="M240.971 130.524l194.343 194.343c9.373 9.373 9.373 24.569 0 33.941l-22.667 22.667c-9.357 9.357-24.522 9.375-33.901.04L224 227.495 69.255 381.516c-9.379 9.335-24.544 9.317-33.901-.04l-22.667-22.667c-9.373-9.373-9.373-24.569 0-33.941L207.03 130.525c9.372-9.373 24.568-9.373 33.941-.001z"/></svg>
            </button>
            <button type="button" class="toc-widget__toggle-button toc-widget__toggle-button--expand" aria-label="Open table of contents">
              <svg viewBox="0 0 448 512"><path d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/></svg>
            </button>
          </div>
          <div class="toc-widget__body" id="toc-body">
            <ol class="toc-widget__list" id="sidebar-toc-list"></ol>
          </div>
        </div>

        <!-- Category card -->
        <div class="sidebar-card">
          <p class="sidebar-card-label">Browse More</p>
          <p class="sidebar-card-title">Explore all coastal &amp; outdoor ideas</p>
          <a href="/blog" class="btn btn-primary sidebar-card-btn">
            View all ideas
            <svg viewBox="0 0 16 16" fill="none" width="12" height="12" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </a>
        </div>

      </aside>

    </div>

    <!-- ── Related posts (full width) ── -->
    {related.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <div class="container">
          <h2 class="display related-title" id="related-heading">Read Next</h2>
          <div class="grid-3 related-grid">
            {related.map((p, i) => (
              <PostCard
                title={p.data.title}
                description={p.data.description}
                slug={p.id}
                image={p.data.image}
                category={p.data.category}
                readTime={p.data.readTime}
                datePublished={p.data.datePublished}
                index={i}
              />
            ))}
          </div>
        </div>
      </section>
    )}

  </div>
</BlogPost>

<style>
/* ── Wrapper ── */
.post-wrap { padding-bottom: 80px; }

/* ── Post header ── */
.post-header-wrap {
  border-bottom: 1px solid var(--color-border);
  padding: 32px 0 28px;
}
@media (min-width: 768px) {
  .post-header-wrap { padding: 48px 0 40px; }
}
.post-cat { margin-bottom: 16px; display: inline-block; }

.post-title {
  font-size: clamp(1.6rem, 4.5vw, 3rem);
  font-weight: 700;
  margin: 0 0 1.25rem 0;
  line-height: 1.15;
  max-width: 780px;
  overflow-wrap: break-word;
  word-break: break-word;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-heading);
  font-size: 0.82rem;
  color: var(--color-text-muted);
  flex-wrap: wrap;
}
.post-meta-author { font-weight: 600; color: var(--color-heading); }
.post-meta-sep { color: var(--color-border); }

.post-header {
  overflow-x: hidden;
}

/* ── Two-column layout ── */
.post-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  padding-top: 40px;
  align-items: start;
}

@media (min-width: 1024px) {
  .post-layout {
    grid-template-columns: 1fr 300px;
    gap: 64px;
  }
}

/* ── Main content ── */
.post-main {
  overflow-x: hidden;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
}

.hero-section {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 24px;
}
@media (min-width: 640px) {
  .hero-section { padding: 0 40px; }
}
.post-hero-img {
  margin: 0 0 2rem;
  aspect-ratio: 16 / 9;
  border-radius: 2px;
  overflow: hidden;
}


/* Post content */
.post-content { margin: 0 0 2rem; }
.post-content :global(h2) {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
  font-size: clamp(1.4rem, 3vw, 1.9rem);
  color: #111111;
  margin-top: 2.5rem;
  line-height: 1.3;
  border-bottom: 2px solid var(--color-border);
  padding-bottom: 6px;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12px;
  max-width: 100%;
}
.post-content :global(.h2-num) {
  font-family: var(--font-display);
  font-size: clamp(1rem, 2vw, 1.2rem);
  font-weight: 400;
  font-style: italic;
  color: var(--color-primary);
  flex-shrink: 0;
}
.post-content :global(.h2-title) {
  display: block;
  flex: 1;
  min-width: 0;
}
.post-content :global(h3) {
  font-family: var(--font-heading);
  font-style: normal;
  font-weight: 600;
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: var(--color-primary);
  margin-top: 1.8rem;
  overflow-wrap: break-word;
  word-break: break-word;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10px;
  max-width: 100%;
}
.post-content :global(.h3-num) {
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 500;
  font-style: normal;
  color: var(--color-primary);
  flex-shrink: 0;
  opacity: 0.85;
}
.post-content :global(.h3-title) {
  display: block;
  flex: 1;
  min-width: 0;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.post-content :global(.img-wrap) {
  margin: 2rem 0;
  aspect-ratio: 16 / 9;
}
.post-content :global(img) {
  max-width: 100%;
  height: auto;
}
.post-content :global(table) {
  display: block;
  overflow-x: auto;
  max-width: 100%;
  -webkit-overflow-scrolling: touch;
}

/* Author bio */
.author-bio {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  margin-top: 3rem;
  padding: 28px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}
.author-bio-logo {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--color-heading);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bio-logo-initial {
  font-family: var(--font-heading);
  font-size: 1.7rem;
  font-weight: 700;
  color: var(--color-white);
  line-height: 1;
  letter-spacing: -0.02em;
}
.author-bio-name {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  color: var(--color-heading);
  margin-bottom: 6px;
}
.author-bio p {
  font-size: 0.875rem;
  color: var(--color-text-muted);
  line-height: 1.65;
  margin: 0;
}

/* Tags */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 2rem;
}
.post-tag {
  padding: 6px 16px;
  background: transparent;
  border: 1px solid var(--color-border);
  border-radius: 100px;
  font-family: var(--font-heading);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-text-muted);
  letter-spacing: 0.04em;
  transition: border-color var(--transition), color var(--transition);
  text-decoration: none;
}
.post-tag:hover { border-color: var(--color-heading); color: var(--color-heading); text-decoration: none; }

/* ── Sidebar ── */
.post-sidebar {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

@media (min-width: 1024px) {
  .post-sidebar {
    position: sticky;
    top: 88px; /* header height + gap */
  }
}

/* TOC Widget */
.toc-widget {
  background: var(--color-surface-warm);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  font-family: var(--font-heading);
}
.toc-widget__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  cursor: pointer;
  background: var(--color-heading);
  border-radius: 6px 6px 0 0;
  user-select: none;
}
.toc-widget__header-title {
  margin: 0;
  flex: 1;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: #ffffff;
}
.toc-widget__toggle-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
  color: rgba(255,255,255,0.7);
}
.toc-widget__toggle-button svg { width: 12px; height: 12px; fill: currentColor; }
.toc-widget__toggle-button--collapse { display: flex; }
.toc-widget__toggle-button--expand   { display: none; }
.toc-widget.is-collapsed .toc-widget__toggle-button--collapse { display: none; }
.toc-widget.is-collapsed .toc-widget__toggle-button--expand   { display: flex; }
.toc-widget.is-collapsed .toc-widget__header { border-radius: 6px; }
.toc-widget__body {
  overflow-y: auto;
  max-height: min(2000px, calc(100vh - 180px));
  transition: max-height 0.3s ease;
  border-top: 1px solid var(--color-border);
  scrollbar-width: thin;
}
.toc-widget.is-collapsed .toc-widget__body {
  max-height: 0;
  overflow: hidden;
  border-top-color: transparent;
}
:global(.toc-widget__list) {
  list-style: none;
  counter-reset: toc-counter;
  margin: 0;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
:global(.toc-widget__list-item) {
  counter-increment: toc-counter;
  margin-bottom: 12px;
}
:global(.toc-widget__list-item:last-child) { margin-bottom: 0; }
:global(.toc-widget__list-item-text-wrapper) {
  display: flex;
  align-items: baseline;
  gap: 10px;
}
:global(.toc-widget__list-item-text-wrapper::before) {
  content: counter(toc-counter) ".";
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--color-text-muted);
  min-width: 20px;
  flex-shrink: 0;
}
:global(.toc-widget__list-item-text) {
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--color-heading) !important;
  text-decoration: none !important;
  transition: color 0.2s;
}
:global(.toc-widget__list-item-text:hover) { color: var(--color-primary) !important; text-decoration: none !important; }
:global(.toc-widget__list-item-text.is-active) { color: var(--color-primary) !important; font-weight: 600; }

/* Sidebar card */
.sidebar-card {
  background: var(--color-dark);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.sidebar-card-label {
  font-family: var(--font-heading);
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-accent);
  margin: 0;
}
.sidebar-card-title {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.2rem;
  color: var(--color-white);
  line-height: 1.3;
  margin: 0;
}
/* Below 1024px the layout stacks single-column (see .post-layout above);
   move the dynamic TOC ahead of the article body so readers see it before
   scrolling past the content, matching Canada/UK's mobile TOC placement.
   The "Browse More" card stays below the article -- it's a secondary CTA,
   not navigation, same as Canada hiding its mobile sidebar-cta. This block
   must come after the unconditional .sidebar-card rule above -- equal
   specificity means source order decides the tie, and a later
   unconditional rule beats an earlier media-scoped one even when the
   media query matches. */
@media (max-width: 1023px) {
  .post-layout { display: flex; flex-direction: column; }
  .post-sidebar { order: -1; margin-bottom: 8px; }
  .post-main { order: 1; }
  .sidebar-card { display: none; }
}

.sidebar-card-btn {
  align-self: flex-start;
  margin-top: 4px;
  font-size: 0.75rem;
}

/* ── Reading progress bar ── */
.reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 0%;
  height: 3px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  z-index: 9999;
  transition: width 0.1s linear;
  pointer-events: none;
}

/* ── Back to top ── */
.back-to-top {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 44px;
  height: 44px;
  background: var(--color-heading);
  color: #ffffff;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
  opacity: 0;
  transform: translateY(12px);
  transition: opacity 0.3s ease, transform 0.3s ease, background 0.2s ease;
  pointer-events: none;
  border-radius: 2px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.18);
}
@media (max-width: 768px) {
  .back-to-top { bottom: 96px; }
}
.back-to-top.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
}
.back-to-top:hover { background: var(--color-primary); }

/* ── Share widget ── */
/* ── Related posts ── */
.related-section {
  padding: 72px 0;
  background: var(--color-surface-warm);
  margin-top: 3rem;
}
.related-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  margin: 0 0 40px 0;
  line-height: 1.1;
}
.related-grid { gap: 32px; }
.related-grid :global(.post-card) { background: var(--color-bg); }
</style>

<script>
// ── Reading progress bar ──
(function () {
  const bar = document.getElementById('reading-progress');
  if (!bar) return;
  function updateProgress() {
    const scrollTop  = window.scrollY;
    const docHeight  = document.documentElement.scrollHeight - window.innerHeight;
    const pct        = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
    bar.style.width  = pct + '%';
    bar.setAttribute('aria-valuenow', String(Math.round(pct)));
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
})();

// ── Back to top ──
(function () {
  const btn = document.getElementById('back-to-top');
  if (!btn) return;
  window.addEventListener('scroll', () => {
    btn.classList.toggle('is-visible', window.scrollY > 400);
  }, { passive: true });
  btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
})();

// ── H2 + H3 number decoration (01., 1.1 — matches Canada/UK style) ──
(function () {
  const H2_SKIP = new Set(['tl;dr', 'tl:dr', '—', '–']);
  const allHeadings = document.querySelectorAll('.post-body h2, .post-body h3');
  let h2Counter = 0;
  let h3Counter = 0;
  allHeadings.forEach((h) => {
    const fullText = (h.textContent ?? '').trim();
    if (h.tagName === 'H2') {
      if (H2_SKIP.has(fullText.toLowerCase())) return;
      const stripped = fullText.replace(/^\d+\.\s*/, '').replace(/^tip\s*\d+\s*[:–-]\s*/i, '').trim();
      h2Counter++;
      h3Counter = 0;
      const numSpan = document.createElement('span');
      numSpan.className = 'h2-num';
      numSpan.textContent = String(h2Counter).padStart(2, '0') + '.';
      const titleSpan = document.createElement('span');
      titleSpan.className = 'h2-title';
      titleSpan.textContent = stripped;
      h.textContent = '';
      h.appendChild(numSpan);
      h.appendChild(titleSpan);
    } else {
      if (h2Counter === 0) h2Counter = 1;
      h3Counter++;
      const stripped = fullText.replace(/^tip\s*\d+\s*[:–-]\s*/i, '').trim();
      const numSpan = document.createElement('span');
      numSpan.className = 'h3-num';
      numSpan.textContent = `${h2Counter}.${h3Counter}`;
      const titleSpan = document.createElement('span');
      titleSpan.className = 'h3-title';
      titleSpan.textContent = stripped;
      h.textContent = '';
      h.appendChild(numSpan);
      h.appendChild(titleSpan);
    }
  });
})();

// ── TOC + scroll spy ──
(function () {
  const headings   = document.querySelectorAll('.post-body h2');
  const tocList    = document.getElementById('sidebar-toc-list');
  const sidebarToc = document.getElementById('sidebar-toc');
  const tocBody    = document.getElementById('toc-body');

  if ([...headings].length < 2) {
    sidebarToc?.remove();
    return;
  }

  headings.forEach((h, i) => {
    if (!h.id) h.id = `section-${i}`;
    const li      = document.createElement('li');
    li.className  = 'toc-widget__list-item';
    const wrapper = document.createElement('div');
    wrapper.className = 'toc-widget__list-item-text-wrapper';
    const a       = document.createElement('a');
    a.className   = 'toc-widget__list-item-text';
    a.href        = `#${h.id}`;
    a.textContent = (h.textContent?.trim() ?? '').replace(/^\d+\.\s*/, '').replace(/^tip\s*\d+\s*[:–-]\s*/i, '');
    wrapper.appendChild(a);
    li.appendChild(wrapper);
    tocList?.appendChild(li);
  });

  const links = [...(tocList?.querySelectorAll('.toc-widget__list-item-text') ?? [])];
  let prevActive = -1;

  function scrollTocToActive(index) {
    if (!tocBody || index < 0) return;
    const item = links[index]?.closest('li');
    if (!item) return;
    const itemTop    = (item as HTMLElement).offsetTop;
    const itemBottom = itemTop + (item as HTMLElement).offsetHeight;
    const scrollTop  = tocBody.scrollTop;
    const height     = tocBody.clientHeight;
    if (itemTop < scrollTop + 16)               tocBody.scrollTop = itemTop - 16;
    else if (itemBottom > scrollTop + height - 16) tocBody.scrollTop = itemBottom - height + 16;
  }

  function setActive() {
    let active = -1;
    headings.forEach((h, i) => {
      if (h.getBoundingClientRect().top <= window.innerHeight * 0.35) active = i;
    });
    links.forEach((l, i) => l.classList.toggle('is-active', i === active));
    if (active !== prevActive) { prevActive = active; scrollTocToActive(active); }
  }

  setActive();
  window.addEventListener('scroll', () => requestAnimationFrame(setActive), { passive: true });

  document.getElementById('toc-header')?.addEventListener('click', () => {
    sidebarToc?.classList.toggle('is-collapsed');
  });

  if (window.innerWidth <= 640) sidebarToc?.classList.add('is-collapsed');
})();
</script>
