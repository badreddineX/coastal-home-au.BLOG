---
import SEO    from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <SEO
      title="About the Author — Outdoor & Coastal Home"
      description="Meet Badreddine Br, the writer behind Outdoor & Coastal Home — sharing honest coastal living and outdoor entertaining ideas for real Australian homes."
      path="/author"
      type="website"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main id="main-content">

      <section class="author-hero">
        <div class="author-hero-inner">
          <div class="author-avatar-circle">
            <span class="author-initials">BB</span>
          </div>
          <span class="author-eyebrow">Written By</span>
          <h1 class="author-heading">Badreddine Br</h1>
          <p class="author-sub">Gold Coast home decor enthusiast · Writing since 2026</p>
        </div>
      </section>

      <section class="author-body">
        <div class="author-inner">

          <div class="author-block">
            <h2>Background</h2>
            <p>
              I spent years scrolling through beautiful home decor content feeling quietly frustrated —
              outdoor entertaining areas styled too formal for the way Australians actually live, and
              seasonal content that assumed you were rugging up for winter in December. Outdoor &amp;
              Coastal Home is the resource I wished existed: written for Australian seasons, with
              Australian retailers in mind.
            </p>
            <p>
              I'm not a professional interior designer. What I bring is genuine enthusiasm and a lot of
              hands-on trial and error — testing real products and layouts, and being honest about what
              actually holds up in our climate versus what only looks good in a staged photo.
            </p>
          </div>

          <div class="author-block">
            <h2>What I actually do for this site</h2>
            <ul>
              <li>Research and, where possible, test ideas before recommending them — prices and availability checked against Australian retailers (Bunnings, Temple &amp; Webster, Kmart, Adairs, Beacon Lighting, Freedom, IKEA Australia)</li>
              <li>Write every guide around Australian conditions: coastal exposure, council fire and building rules, and real AUD budgets</li>
              <li>Update posts when prices or product availability change, rather than leaving stale information live</li>
              <li>Reply personally to every message sent through <a href="/contact">the contact page</a></li>
            </ul>
          </div>

          <div class="author-block">
            <h2>Editorial approach</h2>
            <p>
              Full detail on how content here gets researched, written, and corrected is on the
              <a href="/editorial-policy">Editorial Policy page</a>. Short version: real research where
              possible, accurate AUD pricing always, and no sponsored placements dressed up as genuine
              recommendations.
            </p>
          </div>

          <div class="author-cta">
            <a href="/blog" class="author-btn">Read the Blog &rarr;</a>
            <a href="/contact" class="author-btn author-btn--ghost">Get in Touch</a>
          </div>

        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
.author-hero {
  background: var(--color-surface-warm);
  padding: 5rem 2rem 3.5rem;
  text-align: center;
  border-bottom: 1px solid var(--color-border);
}
.author-hero-inner { max-width: 560px; margin: 0 auto; }
.author-avatar-circle {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1.5rem;
  background: var(--color-heading);
}
.author-initials {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.05em;
}
.author-eyebrow {
  font-family: var(--font-heading);
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-primary);
  display: block;
  margin-bottom: 0.75rem;
}
.author-heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 700;
  color: var(--color-heading);
  margin: 0 0 0.75rem;
  line-height: 1.1;
}
.author-sub {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  margin: 0;
}

.author-body { background: var(--color-bg); padding: 4.5rem 2rem 6rem; }
.author-inner { max-width: 700px; margin: 0 auto; }
.author-block { margin-bottom: 2.75rem; }
.author-block:last-of-type { margin-bottom: 0; }
.author-block h2 {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-heading);
  margin: 0 0 1rem;
}
.author-block p {
  font-size: 0.95rem;
  line-height: 1.85;
  color: var(--color-text-muted);
  margin: 0 0 1.1rem;
}
.author-block p:last-child { margin-bottom: 0; }
.author-block a { color: var(--color-primary); }
.author-block ul {
  margin: 0;
  padding-left: 1.3rem;
  color: var(--color-text-muted);
}
.author-block ul li {
  font-size: 0.95rem;
  line-height: 1.85;
  margin-bottom: 0.5rem;
}
.author-cta { display: flex; gap: 1rem; margin-top: 3rem; flex-wrap: wrap; }
.author-btn {
  display: inline-block;
  background: var(--color-heading);
  color: #ffffff;
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 0.85rem 1.75rem;
  border-radius: 2px;
  transition: background 200ms;
}
.author-btn:hover { background: var(--color-dark); color: #fff; }
.author-btn--ghost {
  background: transparent;
  color: var(--color-heading);
  border: 1px solid var(--color-border);
}
.author-btn--ghost:hover { background: var(--color-surface-warm); }

@media (max-width: 640px) {
  .author-hero { padding: 3.5rem 1.25rem 2.5rem; }
  .author-body { padding: 3rem 1.25rem 4rem; }
}
</style>
