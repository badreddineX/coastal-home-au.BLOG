---
import SEO    from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <SEO
      title="Message Sent — Outdoor & Coastal Home"
      description="Thanks for getting in touch — we'll be back to you within 2-3 business days."
      path="/thank-you"
      type="website"
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Header />
    <main id="main-content">

      <section class="thanks">
        <div class="thanks-inner">
          <span class="thanks-icon">&check;</span>
          <h1 class="thanks-heading">Message sent!</h1>
          <p class="thanks-desc">
            Thank you for reaching out — your message has landed safely in our inbox. We'll get back to
            you within 2–3 business days.
          </p>
          <div class="thanks-actions">
            <a href="/" class="thanks-btn thanks-btn--primary">Back to Home</a>
            <a href="/blog" class="thanks-btn thanks-btn--outline">Browse All Articles</a>
          </div>
        </div>
      </section>

    </main>
    <Footer />
  </body>
</html>

<style>
.thanks {
  background: var(--color-bg);
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem 2rem;
}
.thanks-inner { text-align: center; max-width: 520px; }
.thanks-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  margin: 0 auto 1.5rem;
  border-radius: 50%;
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  font-size: 2rem;
  line-height: 1;
}
.thanks-heading {
  font-family: var(--font-heading);
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--color-heading);
  margin: 0 0 1rem;
}
.thanks-desc {
  font-size: 1rem;
  line-height: 1.75;
  color: var(--color-text-muted);
  margin: 0 0 2.5rem;
}
.thanks-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
.thanks-btn {
  display: inline-block;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 0.85rem 1.75rem;
  border-radius: 2px;
  transition: background 200ms, color 200ms, border-color 200ms;
}
.thanks-btn--primary { background: var(--color-heading); color: #fff; border: 1px solid var(--color-heading); }
.thanks-btn--primary:hover { background: var(--color-dark); border-color: var(--color-dark); }
.thanks-btn--outline { background: transparent; color: var(--color-heading); border: 1px solid var(--color-border); }
.thanks-btn--outline:hover { border-color: var(--color-heading); }
</style>
